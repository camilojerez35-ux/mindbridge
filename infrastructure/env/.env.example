DATABASE_URLsdsdfsdhttps://fnebfwvgnrvunvhvszlu.supabase.co   https://fnebfwvgnrvunvhvszlu.supabase.co="postgresql://mindbridge_user:password@localhost:5432/mindbridge_db"
