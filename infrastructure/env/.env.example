# ── REDIS (Sesiones y caché) ────────────────────────────────────
REDIS_URLas="redis://localhost:6379"
REDIS_PASSWORDaas=""

# ── ANTHROPIC — CLAUDE API ──────────────────────────────────────
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODELsdsd="claude-sonnet-4-20250514"
ANTHROPIC_MAX_TOKENS=1024

# ── AUTENTICACIÓN (NextAuth.js) ─────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRETxcxc="genera-con: openssl rand -base64 32"

# Proveedor Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── PAGOS — WOMPI COLOMBIA ──────────────────────────────────────
# Obtener en: https://wompi.co/developers
WOMPI_PUBLIC_KEYxcxc="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_EVENTS_SECRET="eventos_..."
WOMPI_SANDBOX=true

# ── PAGOS — EPAICO (alternativa) ───────────────────────────────
EPAICO_CLIENT_ID=""
EPAICO_SECRET_KEY=""
EPAICO_SANDBOX=true

# ── VIDEOLLAMADA — DAILY.CO ─────────────────────────────────────
# Obtener en: https://dashboard.daily.co
DAILY_API_KEY=""
DAILY_DOMAIN="tu-dominio.daily.co"

# ── EMAIL — SENDGRID ────────────────────────────────────────────
SENDGRID_API_KEY="SG...."
EMAIL_FROM="noreply@mindbridge.co"
EMAIL_FROM_NAME="MindBridge Colombia"

# ── NOTIFICACIONES PUSH — FIREBASE ─────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ── MONITOREO — SENTRY ─────────────────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── ANALYTICS — POSTHOG ────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── SEGURIDAD ───────────────────────────────────────────────────
# Clave para cifrar datos sensibles (AES-256)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY="genera-clave-de-64-chars-hex"

# JWT para tokens internos
JWT_SECRET="genera-con: openssl rand -base64 64"
JWT_EXPIRY="7d"

# ── LIMITES DE SESIONES POR PLAN ────────────────────────────────
LIMITE_SESIONES_GRATIS_SEMANA=3
LIMITE_SESIONES_PLUS=-1        # -1 = ilimitado
LIMITE_SESIONES_FAMILIA=-1

# ── CRISIS — CONTACTOS DE EMERGENCIA ───────────────────────────
# No modificar sin aprobación del Psicólogo Co-Fundador
LINEA_CRISIS_BOGOTA="106"
LINEA_CRISIS_NACIONAL="800-1222-5555"
LINEA_EMERGENCIAS="123"

# ── PLATAFORMA — COMISIONES ────────────────────────────────────
COMISION_CITAS_PORCENTAJE=20  # 20% de cada cita

# ── COLPSIC — VERIFICACIÓN DE PSICÓLOGOS ───────────────────────
# API de verificación de tarjetas profesionales (si disponible)
COLPSIC_API_URL=""
COLPSIC_API_KEY=""

# ── ALMACENAMIENTO — AWS S3 (para fotos y archivos) ────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="mindbridge-files"

# ── RATE LIMITING ───────────────────────────────────────────────
RATE_LIMIT_CHAT_POR_MINUTO=10
RATE_LIMIT_API_POR_MINUTO=60

# ── FEATURE FLAGS ───────────────────────────────────────────────
FEATURE_PROGRAMA_ANSIEDAD=true
FEATURE_APP_MOVIL=false
FEATURE_B2B_DASHBOARD=false
FEATURE_REFERIDOS=false
