{
  "expo": {
    "name": "MindBridge",
    "slug": "mindbridge",
    "version": "1.0.0",
    "scheme": "mindbridge",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mindbridge.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.mindbridge.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10B981",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "MindBridge"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
