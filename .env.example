# ── Base ──────────────────────────────────────────────────────────
APP_URL=https://tu-dominio.co
NODE_ENV=production

# ── Next Auth ─────────────────────────────────────────────────────
NEXTAUTH_URL=https://tu-dominio.co
NEXTAUTH_SECRET=minimo-32-caracteres-aleatorios-aqui

# ── Base de datos (Supabase) ───────────────────────────────────────
# Transaction pooler (port 6543) para Prisma en serverless
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true
# Direct connection (port 5432) para migraciones
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Encriptación (AES-256-GCM) ─────────────────────────────────────
# IMPORTANTE: Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA usar el valor de ejemplo en producción — los datos de salud quedarían desprotegidos
ENCRYPTION_KEY=CAMBIAR-genera-con-el-comando-de-arriba-64-chars-hex

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── Wompi (pagos Colombia) ─────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=prv_prod_xxx
WOMPI_EVENTS_SECRET=xxx
WOMPI_SANDBOX=false
COMISION_CITAS_PORCENTAJE=15

# ── Email — Resend (https://resend.com) ───────────────────────────
# Plan gratuito: 3.000 emails/mes — https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@tu-dominio.co
EMAIL_FROM_NAME=MindBridge Colombia

# ── Redis — Upstash (rate limiting multi-instancia) ───────────────
# Sin esto el rate limiting solo funciona en una instancia (dev)
# https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Alertas de crisis (Slack) ─────────────────────────────────────
# Webhook para alertas cuando se detecta un paciente en crisis
# Slack → Apps → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_CRISIS=https://hooks.slack.com/services/xxx/yyy/zzz

# ── PostHog (analytics) ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Daily.co (videocitas) ─────────────────────────────────────────
DAILY_API_KEY=xxx

# ── Cron jobs ─────────────────────────────────────────────────────
CRON_SECRET=minimo-32-caracteres-aleatorios-aqui

# ── Rate limits (opcional, defaults en código) ─────────────────────
RATE_LIMIT_CHAT_POR_MINUTO=10
RATE_LIMIT_API_POR_MINUTO=60

# ── BetterStack (logs y uptime monitoring) ────────────────────────
# https://betterstack.com/logs — plan gratuito disponible
BETTERSTACK_SOURCE_TOKEN=
