{
  "$schema": "https://turbo.build/schema.v2.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".expo/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "APP_URL",
        "JWT_SECRET",
        "ENCRYPTION_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_MAX_TOKENS",
        "CRON_SECRET",
        "WOMPI_PUBLIC_KEY",
        "WOMPI_PRIVATE_KEY",
        "WOMPI_EVENTS_SECRET",
        "WOMPI_INTEGRITY_KEY",
        "WOMPI_SANDBOX",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_APP_ENV"
      ]
    },
    "lint": {},
    "test": {},
    "typecheck": {},
    "start": { "cache": false, "persistent": true }
  }
}
